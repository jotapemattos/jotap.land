---
import EntryList from "../../components/EntryList.astro";
import PageHeader from "../../components/PageHeader.astro";
import Layout from "../../layouts/Layout.astro";
import { getStudyCases, isoDate } from "../../lib/content";

const cases = await getStudyCases();
---

<Layout
  title="Study Cases — João Pedro"
  description="Longer write-ups of work: the problem, the constraints, and what I'd do differently."
>
  <main
    id="main"
    class="mx-auto flex w-full max-w-prose flex-col gap-12 px-6 py-16 md:py-24"
  >
    <PageHeader
      eyebrow="study cases"
      title="Study Cases"
      lede="Longer write-ups of real work: the problem, the constraints, the trade-offs, and what I'd do differently."
      meta={`${cases.length} ${cases.length === 1 ? "case" : "cases"}`}
    />

    <EntryList
      empty="No cases published yet."
      entries={cases.map((item) => ({
        href: `/study-cases/${item.id}`,
        title: item.data.title,
        meta: isoDate(item.data.pubDate),
        note: item.data.tagline,
      }))}
    />
  </main>
</Layout>
