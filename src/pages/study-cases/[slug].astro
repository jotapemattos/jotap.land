---
import { render } from "astro:content";
import type { GetStaticPaths } from "astro";
import PageHeader from "../../components/PageHeader.astro";
import Prose from "../../components/Prose.astro";
import Layout from "../../layouts/Layout.astro";
import {
  getStudyCases,
  longDate,
  type StudyCaseEntry,
} from "../../lib/content";

interface Props {
  item: StudyCaseEntry;
}

export const getStaticPaths: GetStaticPaths = async () => {
  const cases = await getStudyCases();
  return cases.map((item) => ({ params: { slug: item.id }, props: { item } }));
};

const { item } = Astro.props;
const { Content } = await render(item);

const meta = [longDate(item.data.pubDate), item.data.role]
  .filter(Boolean)
  .join(" · ");
---

<Layout
  title={`${item.data.title} — João Pedro`}
  description={item.data.description ?? item.data.tagline}
>
  <main
    id="main"
    class="mx-auto flex w-full max-w-[68ch] flex-col gap-10 px-6 py-16 md:py-24"
  >
    <a class="link w-fit font-mono text-xs text-ink-600" href="/study-cases">
      ← study cases
    </a>

    <PageHeader
      title={item.data.title}
      lede={item.data.description ?? item.data.tagline}
      meta={meta}
    />

    <hr />

    <article class="rise">
      <Prose>
        <Content />
      </Prose>
    </article>
  </main>
</Layout>
