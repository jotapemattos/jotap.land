---
import Frame from "../components/Frame.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 — João Pedro" description="This page doesn't exist.">
  <main
    id="main"
    class="mx-auto flex w-full max-w-[68ch] flex-col gap-8 px-6 py-24 md:py-32"
  >
    <Frame label="404" class="flex flex-col items-center gap-4 px-6 py-14 rise">
      <p class="font-serif text-4xl text-ink">Nothing here</p>
      <p class="max-w-[42ch] text-center text-sm text-ink-600">
        This page doesn't exist — or it did, and I moved it.
      </p>
      <a class="link mt-2 font-mono text-xs text-ink-800" href="/"
        >← back home</a
      >
    </Frame>
  </main>
</Layout>
