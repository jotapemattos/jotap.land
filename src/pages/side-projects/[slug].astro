---
import { render } from "astro:content";
import type { GetStaticPaths } from "astro";
import Frame from "../../components/Frame.astro";
import PageHeader from "../../components/PageHeader.astro";
import Prose from "../../components/Prose.astro";
import Layout from "../../layouts/Layout.astro";
import {
  getSideProjects,
  hostOf,
  type SideProjectEntry,
} from "../../lib/content";

interface Props {
  project: SideProjectEntry;
}

export const getStaticPaths: GetStaticPaths = async () => {
  const projects = await getSideProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
};

const { project } = Astro.props;
const { Content } = await render(project);
const { name, tagline, description, year, status, stack, repoUrl, liveUrl } =
  project.data;

const meta = [year, status !== "live" ? status : null]
  .filter(Boolean)
  .join(" · ");
---

<Layout title={`${name} — João Pedro`} description={description ?? tagline}>
  <main
    id="main"
    class="mx-auto flex w-full max-w-prose flex-col gap-10 px-6 py-16 md:py-24"
  >
    <a class="link w-fit font-mono text-xs text-ink-600" href="/side-projects">
      ← side projects
    </a>

    <PageHeader title={name} lede={description ?? tagline} meta={meta} />

    {
      (stack.length > 0 || repoUrl || liveUrl) && (
        <Frame label="details" class="flex flex-col gap-5 px-5 py-8 md:px-8">
          {stack.length > 0 && (
            <div class="flex flex-col gap-2">
              <h2 class="font-mono text-[11px] uppercase tracking-[0.2em] text-ink-600">
                Stack
              </h2>
              <ul class="flex flex-wrap gap-2">
                {stack.map((item) => (
                  <li class="rounded-md border border-dashed border-ink/15 bg-paper-raised/60 px-2 py-0.5 font-mono text-[11px] text-ink-800">
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          )}

          {(repoUrl || liveUrl) && (
            <div class="flex flex-col gap-2">
              <h2 class="font-mono text-[11px] uppercase tracking-[0.2em] text-ink-600">
                Links
              </h2>
              <ul class="flex flex-wrap gap-x-5 gap-y-2 font-mono text-xs">
                {liveUrl && (
                  <li>
                    <a
                      class="link text-ink-800"
                      href={liveUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      ↗ {hostOf(liveUrl)}
                    </a>
                  </li>
                )}
                {repoUrl && (
                  <li>
                    <a
                      class="link text-ink-800"
                      href={repoUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      ↗ source
                    </a>
                  </li>
                )}
              </ul>
            </div>
          )}
        </Frame>
      )
    }

    <article class="rise">
      <Prose>
        <Content />
      </Prose>
    </article>
  </main>
</Layout>
