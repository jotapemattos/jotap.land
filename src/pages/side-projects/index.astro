---
import EntryList from "../../components/EntryList.astro";
import PageHeader from "../../components/PageHeader.astro";
import Layout from "../../layouts/Layout.astro";
import { getSideProjects } from "../../lib/content";

const projects = await getSideProjects();
---

<Layout
  title="Side Projects — João Pedro"
  description="Things I built outside of work, for the fun of building them."
>
  <main
    id="main"
    class="mx-auto flex w-full max-w-[68ch] flex-col gap-12 px-6 py-16 md:py-24"
  >
    <PageHeader
      eyebrow="side projects"
      title="Side Projects"
      lede="Things I built outside of work, mostly to answer a question I had."
      meta={`${projects.length} ${projects.length === 1 ? "project" : "projects"}`}
    />

    <EntryList
      empty="Nothing shipped here yet."
      entries={projects.map((project) => ({
        href: `/side-projects/${project.id}`,
        title: project.data.name,
        meta: project.data.year ? String(project.data.year) : undefined,
        note: project.data.tagline,
      }))}
    />
  </main>
</Layout>
