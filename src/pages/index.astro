---
import EntryList from "../components/EntryList.astro";
import Frame from "../components/Frame.astro";
import Layout from "../layouts/Layout.astro";
import {
  getBookmarks,
  getSideProjects,
  getWriting,
  hostOf,
  isoDate,
} from "../lib/content";

const [writing, projects, bookmarks] = await Promise.all([
  getWriting(),
  getSideProjects(),
  getBookmarks(),
]);
---

<Layout title="João Pedro — software engineer">
  <main
    id="main"
    class="mx-auto flex w-full max-w-[68ch] flex-col gap-20 px-6 py-16 md:py-24"
  >
    <section class="flex flex-col gap-6 rise">
      <p
        class="font-mono text-[11px] uppercase tracking-[0.2em] text-accent-600"
      >
        [&nbsp;jotap.land&nbsp;]
      </p>
      <h1 class="font-serif text-4xl leading-[1.1] text-ink md:text-5xl">
        Yo, João Pedro here
      </h1>
      <p
        class="max-w-[58ch] text-sm leading-relaxed text-ink-700 md:text-[15px]"
      >
        I'm a software engineer based in Brazil. This is where I keep the things
        I make, the things I'm figuring out, and the things worth linking to.
      </p>
    </section>

    <Frame
      label="now"
      class="px-5 py-8 md:px-8 rise"
      style="animation-delay: 60ms"
    >
      <div
        class="flex flex-col gap-4 text-sm leading-relaxed text-ink-700 md:text-[15px]"
      >
        <p>
          Currently at <a
            class="link-inline"
            href="https://www.intranetmall.com.br/br/"
            target="_blank"
            rel="noopener noreferrer">IntranetMall</a
          > as a <em class="not-italic text-ink">Software Engineer</em>, turning
          complex ideas into polished digital experiences. My focus right now is
          backend development and system design — how to build things that stay
          scalable and robust as they grow.
        </p>
        <p>
          Outside of work: photography, <a
            class="link-inline"
            href="https://letterboxd.com/jotapzn/"
            target="_blank"
            rel="noopener noreferrer">movies</a
          >, <a
            class="link-inline"
            href="https://open.spotify.com/user/yw78qs7x7uerkgmw6ngpsd75n"
            target="_blank"
            rel="noopener noreferrer">good music</a
          >, and new recipes.
        </p>
      </div>
    </Frame>

    <section class="flex flex-col gap-5 rise" style="animation-delay: 100ms">
      <div class="flex items-baseline justify-between gap-4">
        <h2
          class="font-mono text-[11px] uppercase tracking-[0.2em] text-accent-600"
        >
          [&nbsp;writing&nbsp;]
        </h2>
        <a class="link font-mono text-xs text-ink-600" href="/writing">
          all posts →
        </a>
      </div>
      <EntryList
        empty="First post is still cooking."
        entries={writing.slice(0, 5).map((post) => ({
          href: `/writing/${post.id}`,
          title: post.data.title,
          meta: isoDate(post.data.pubDate),
        }))}
      />
    </section>

    <section class="flex flex-col gap-5 rise" style="animation-delay: 140ms">
      <div class="flex items-baseline justify-between gap-4">
        <h2
          class="font-mono text-[11px] uppercase tracking-[0.2em] text-accent-600"
        >
          [&nbsp;side projects&nbsp;]
        </h2>
        <a class="link font-mono text-xs text-ink-600" href="/side-projects">
          all projects →
        </a>
      </div>
      <EntryList
        empty="Nothing shipped here yet."
        entries={projects.slice(0, 4).map((project) => ({
          href: `/side-projects/${project.id}`,
          title: project.data.name,
          meta: project.data.year ? String(project.data.year) : undefined,
          note: project.data.tagline,
        }))}
      />
    </section>

    <section class="flex flex-col gap-5 rise" style="animation-delay: 180ms">
      <div class="flex items-baseline justify-between gap-4">
        <h2
          class="font-mono text-[11px] uppercase tracking-[0.2em] text-accent-600"
        >
          [&nbsp;bookmarks&nbsp;]
        </h2>
        <a class="link font-mono text-xs text-ink-600" href="/bookmarks">
          all bookmarks →
        </a>
      </div>
      <EntryList
        empty="No bookmarks saved yet."
        entries={bookmarks.slice(0, 5).map((bookmark) => ({
          href: bookmark.data.url,
          title: bookmark.data.title,
          meta: hostOf(bookmark.data.url),
          external: true,
        }))}
      />
    </section>
  </main>
</Layout>
